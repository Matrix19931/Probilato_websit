<%- include('partials/head', { pageTitle: page.title }) %>
<section class="wrap article">
  <h1><%= page.title %></h1>
  <% if (page.intro) { %><p class="lead"><%= page.intro %></p><% } %>
  <div class="prose"><%- toHtml(page.body) %></div>

  <% if (team && team.length) { %>
    <div class="grid-3 team-grid">
      <% team.forEach(function (m) { %>
        <article>
          <% if (m.photo) { %><img class="portrait" src="<%= m.photo %>" alt=""><% } else { %><div class="portrait placeholder">portrait</div><% } %>
          <h3><%= m.name %></h3>
          <div class="meta"><%= m.role %></div>
          <p><%= m.bio %></p>
        </article>
      <% }) %>
    </div>
  <% } %>
</section>
<%- include('partials/foot') %>
