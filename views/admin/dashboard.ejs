<%- include('partials/shell') %>
<h1>Your website</h1>
<p class="hint">Pick the page you want to change. Each screen holds that page’s text and pictures together, exactly as they appear on the website.</p>
<div class="row">
  <% sections.forEach(function (s) { %>
    <div class="card">
      <h2><%= s.label %></h2>
      <p class="hint"><%= s.hint %></p>
      <a class="btn btn-outline" href="/admin/page/<%= s.id %>">Edit</a>
      <a class="btn btn-outline" href="<%= s.view %>" target="_blank">View</a>
    </div>
  <% }) %>
  <div class="card">
    <h2>Messages</h2>
    <p class="hint"><%= counts.unread %> unread of <%= counts.messages %> sent through the contact form.</p>
    <a class="btn btn-outline" href="/admin/messages">Open inbox</a>
  </div>
</div>
<%- include('partials/shell-end') %>
