<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>Probilato — Control panel</title>
<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@400;500;600;700&family=Barlow:wght@300;400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/admin.css"></head><body>
<div class="admin">
  <aside class="side">
    <div class="logo">Probilato</div>
    <div class="sub">CONTROL PANEL</div>
    <nav>
      <a href="/admin" class="<%= section === 'home' ? 'on' : '' %>">Overview</a>
      <div class="navgroup">Pages</div>
      <% sections.forEach(function (s) { %>
        <a href="/admin/page/<%= s.id %>" class="<%= current === s.id ? 'on' : '' %>"><%= s.label %></a>
      <% }) %>
      <div class="navgroup">Inbox</div>
      <a href="/admin/messages" class="<%= section === 'messages' ? 'on' : '' %>">Messages<% if (unread) { %><span class="pill"><%= unread %></span><% } %></a>
    </nav>
    <div class="foot"><a href="/" target="_blank">View website &rarr;</a><br><a href="/admin/logout">Log out</a></div>
  </aside>
  <main class="main">
