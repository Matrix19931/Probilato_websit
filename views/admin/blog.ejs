<%- include('partials/shell') %>
<div class="head"><h1>Blog</h1><a class="btn btn-primary" href="/admin/blog/new">Write a new post</a></div>
<table><thead><tr><th>Date</th><th>Title</th><th>Status</th><th></th></tr></thead><tbody>
<% rows.forEach(function (r) { %>
  <tr>
    <td><%= r.created_at.slice(0,10) %></td>
    <td><%= r.title_de %><br><span class="hint"><%= r.title_en %></span></td>
    <td><span class="tag"><%= r.published ? 'published' : 'draft' %></span></td>
    <td>
      <a class="btn btn-outline" href="/admin/blog/<%= r.id %>">Edit</a>
      <form style="display:inline" method="post" action="/admin/blog/<%= r.id %>/delete" onsubmit="return confirm('Delete this post?')">
        <button class="btn btn-danger" type="submit">Delete</button>
      </form>
    </td>
  </tr>
<% }) %>
</tbody></table>
<%- include('partials/shell-end') %>
