ADMIN_USER=admin
ADMIN_PASSWORD=change-this-password
SESSION_SECRET=change-this-to-a-long-random-string
PORT=3000

# Email for the support form (IONOS mailbox support@probilato.com).
# Without SMTP_PASS no emails are sent (messages still appear in the admin panel).
SMTP_HOST=smtp.ionos.de
SMTP_PORT=465
SMTP_USER=support@probilato.com
SMTP_PASS=the-mailbox-password
SUPPORT_INBOX=support@probilato.com
